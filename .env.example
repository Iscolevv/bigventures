# Neon Postgres (pooled + direct). Used by @bv/db and the dashboard.
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/bigventures?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible) for POD photos, receipts, documents
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_BUCKET="big-ventures"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""   # optional CDN base for thumbnails

# Google Maps Platform — Directions + Geocoding (server), Maps SDK (mobile)
GOOGLE_MAPS_SERVER_KEY=""
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=""

# Mobile app points here
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
